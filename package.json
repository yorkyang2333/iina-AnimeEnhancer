{
  "name": "animeenhancer",
  "version": "1.3.0",
  "description": "Anime Enhancement Plugin for IINA",
  "main": "src/index.js",
  "scripts": {
    "serve-sidebar": "parcel serve ui/sidebar/sidebar.html --dist-dir dist/ui/sidebar",
    "build": "node scripts/build.cjs",
    "pack": "npm run build && node scripts/pack.cjs",
    "test": "node --test tests/*.test.cjs",
    "convert:animejanai": ".venv/bin/python scripts/compile-animejanai.py"
  },
  "author": "yorkyang2333 <yangyork097@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yorkyang2333/iina-anime4k.git"
  },
  "homepage": "https://github.com/yorkyang2333/iina-anime4k#readme",
  "license": "GPL-3.0",
  "devDependencies": {
    "@parcel/transformer-sass": "^2.8.3",
    "iina-plugin-definition": "^0.99.4",
    "prettier": "^3.9.10",
    "process": "^0.11.10"
  },
  "dependencies": {
    "parcel": "^2.8.3",
    "parcel-optimizer-webview": "git+https://github.com/iina/parcel-optimizer-webview.git"
  },
  "browserslist": "safari >= 9",
  "entry": "src/index.js",
  "targets": {
    "main": false,
    "overlay": {
      "distDir": "./dist/ui/overlay",
      "source": "ui/overlay/index.html",
      "publicUrl": "./"
    },
    "sidebar": {
      "distDir": "./dist/ui/sidebar",
      "source": "ui/sidebar/sidebar.html",
      "publicUrl": "./"
    },
    "global": {
      "distDir": "./dist/",
      "source": "src/global.js",
      "isLibrary": false
    },
    "entry": {
      "distDir": "./dist/",
      "source": "src/index.js",
      "isLibrary": false
    }
  }
}
